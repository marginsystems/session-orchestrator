    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "lib": ["es2022", "dom"],
    "target": "es2022",
    "moduleDetection": "legacy",
    "types": [],
    "skipLibCheck": true
  },
  "include": ["office/**/*.js"]
}
